# Canonical origin used for <link rel="canonical"> and the OpenGraph/Twitter tags.
# Leave unset in production to fall back to https://vincentcavanna.com.
# Vercel preview deploys fall back to NEXT_PUBLIC_VERCEL_URL automatically, so
# this only needs setting for self-hosted staging environments.
# NEXT_PUBLIC_SITE_URL=https://staging.vincentcavanna.com
